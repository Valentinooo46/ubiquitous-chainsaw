@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="text-center mb-4">Перевірка заборонених слів</h1>
            <form method="post" action="/Home/CheckForbiddenWords">
                <div class="form-group">
                    <label for="folderPath">Шлях до папки</label>
                    <input type="text" class="form-control" id="folderPath" name="folderPath" placeholder="Введіть шлях до папки(якщо пусто то перевірятиме усі диски)">
                </div>
                <div class="form-group mt-3">
                    <label for="forbiddenWords">Заборонені слова</label>
                    <input type="text" class="form-control" id="forbiddenWords" name="forbiddenWords" placeholder="Введіть заборонені слова через кому" required>
                </div>
                <div class="form-group mt-3">
                    <label for="destinationPath">Шлях для копіювання файлів</label>
                    <input type="text" class="form-control" id="destinationPath" name="destinationPath" placeholder="Введіть шлях для копіювання файлів" required>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary">Перевірити</button>
                </div>
            </form>
            <div class="text-center mt-4">
                <a href="/Home/Report" class="btn btn-secondary">Переглянути звіт</a>
            </div>
        </div>
    </div>
</div>
