@{
    ViewData["Title"] = "Звіт";
    var reportContent = ViewData["ReportContent"] as string[] ?? Array.Empty<string>();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="text-center mb-4">Звіт про перевірку</h1>
            @if (reportContent.Length > 0)
            {
                <div class="card">
                    <div class="card-body">
                        <ul class="list-group">
                            @foreach (var line in reportContent)
                            {
                                <li class="list-group-item">@line</li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    Звіт порожній або ще не створений.
                </div>
            }
            <div class="text-center mt-4">
                <a href="/" class="btn btn-primary">Повернутися на головну</a>
            </div>
        </div>
        
    </div>
</div>
